# Copy to `.env` and fill in. `.env` is gitignored — never commit real
# credentials. Every value below is optional except DATABASE_URL and, in
# production, JWT_SECRET.
#
#   cp .env.example .env       (bash)
#   copy .env.example .env     (cmd / PowerShell)
#
# Measured tuning rationale lives in DEPLOY.md; the short version is in the
# comments here.

# ── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=production — the app refuses to start without it.
JWT_SECRET=
APP_ENV=development
APP_TIMEZONE=Asia/Singapore
# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── Device ───────────────────────────────────────────────────────────
# cpu / cuda. AI_CTX_ID: -1 = CPU, 0 = first GPU. They must agree.
#
# A GPU also needs the right wheels, and a CPU install does NOT fail loudly —
# it just runs ~10x slower. `onnxruntime` (CPU) and `onnxruntime-gpu` install
# into the SAME package directory, so with both present the CPU build wins and
# CUDA vanishes from the provider list while pip still lists the GPU package.
#
# Check before assuming (this is the whole story in one command):
#     python scripts/check_gpu.py
AI_DEVICE=cpu
AI_CTX_ID=-1

# ── Face detection range ─────────────────────────────────────────────
# AI_DETECT_TILES is the strongest range lever: 2x2 roughly doubles usable
# distance at 2x2=4x the detection cost. Keep 1x1 on CPU.
AI_DET_SIZE=1280
AI_DETECT_TILES=1x1
# AI_DET_THRESH=0.5
AI_ANTISPOOF_MIN_FACE_PX=50

# ── Recognition ensemble (CR-03) ─────────────────────────────────────
# The second detector/recogniser roughly doubles inference cost. Leave both
# false on CPU hosts; enable on a GPU rig.
AI_USE_MTCNN=false
AI_USE_FACENET=false
# AI_ARCFACE_THRESHOLD=0.40   # overridden by MODEL_CONFIGS once deployed (U25)

# ── Low-light enhancement ────────────────────────────────────────────
# 'auto' tries a face-restoration GAN and falls back to CLAHE. Applied only
# to frames detected as low-light. Disable entirely on CPU hosts.
AI_USE_ENHANCER=false
AI_ENHANCER=auto

# ── Behaviour analysis (CR-06 / U32–U35) ─────────────────────────────
# Master switch. Off by default so deployments that never use it pay nothing.
AI_BEHAVIOUR=false

# Phone detection. Measured on labelled clips at conf 0.50
# (recall / false-alarm rate):
#     yolov8n  1.00 / 0.000      yolov8m  1.00 / 0.000
#     yolov8s  1.00 / 0.267      yolov8l  1.00 / 0.106
# DO NOT use yolov8s — it scores wall switch panels as phones at up to 0.59,
# and since a wall panel never moves, the same student is blamed all lesson.
# Do not raise AI_PHONE_CONF to compensate for a noisy model either: at 0.80
# yolov8n drops from 1.00 recall to 0.25.
AI_PHONE_MODEL=yolov8n.pt
AI_PHONE_IMGSZ=1280
AI_PHONE_CONF=0.50
# AI_PHONE_CONSEC=5           # ~1 fps sampling, so N samples ≈ N seconds
# AI_PHONE_STATIC_SAMPLES=45  # an immobile box for this long = room fixture
# AI_PHONE_STATIC_IOU=0.80

# Head pose. 'insightface' uses the detector's 3D landmarks and needs no
# extra download; 'solvepnp' uses MediaPipe and skips one inference per face
# but is far weaker — on head-down frames MediaPipe returns no landmarks at
# all 60% of the time, which is exactly when this signal matters.
AI_HEADPOSE_SOURCE=insightface
# AI_HEADPOSE_DELTA_DEG=10    # degrees below personal baseline = head down
# AI_ADAPTIVE_HEADPOSE=true
# AI_HEADPOSE_PITCH_DEG=12    # absolute cutoff, used only when adaptive is off

# Drowsiness. Judged per student against their own open-eye baseline, then
# aggregated with PERCLOS over a rolling window — not a single frame.
# AI_EAR_THRESHOLD=0.21       # used only when AI_ADAPTIVE_EAR=false
# AI_ADAPTIVE_EAR=true
# AI_EAR_BASELINE_SAMPLES=20
# AI_PERCLOS_WINDOW_SECONDS=60
# AI_PERCLOS_THRESHOLD=0.40
# AI_MAR_THRESHOLD=0.6
# AI_BEHAVIOUR_MIN_FACE_PX=64
# AI_HEATMAP_GRID=8x6
# AI_HEATMAP_FLUSH_SECONDS=60

# ── Notifications (U05 / U29) ────────────────────────────────────────
# Leave SMTP_HOST empty to disable email; notifications then no-op silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
